{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OpenBao and the SHA-256 of its checksums.txt release asset",
      "managerFilePatterns": ["/^integration/openbao\\.json$/"],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\",\\s*\"sha256\":\\s*\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "openbao/openbao",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Update the minimum Go version declared in go.mod",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep go.mod and the CI Go versions together",
      "matchManagers": ["gomod", "github-actions"],
      "matchDepNames": ["go"],
      "groupName": "Go",
      "groupSlug": "go"
    },
    {
      "description": "Keep the native OpenBao fixture and both Compose services together",
      "matchPackageNames": ["openbao/openbao", "ghcr.io/openbao/openbao"],
      "groupName": "OpenBao",
      "groupSlug": "openbao",
      "separateMajorMinor": false
    }
  ]
}
